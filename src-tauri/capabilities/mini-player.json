{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mini-player-window",
  "description": "Allows the trusted local Mini Player window to receive playback and language events and use constrained playback controls.",
  "windows": ["mini-player"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-local-ui-language-read",
    "allow-mini-player-state-read",
    "allow-mini-player-control"
  ]
}
