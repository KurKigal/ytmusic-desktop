{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "youtube-music-bridge",
  "description": "Allows music.youtube.com to synchronize playback state and use the constrained player control bridge.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["https://music.youtube.com/*"]
  },
  "permissions": [
    "allow-player-state-update",
    "allow-player-control"
  ]
}